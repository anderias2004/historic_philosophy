{
  "name": "historic-philosophy-cloud-render",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "deploy:function": "remotion lambda functions deploy --region=eu-west-1",
    "deploy:site": "remotion lambda sites create src/index.ts --site-name=historic-philosophy --region=eu-west-1",
    "render:caesar": "remotion lambda render --region=eu-west-1 --codec=h264 --image-format=jpeg --props='{\"title\":\"ژولیوس سزار\",\"hook\":\"مردی که جمهوری روم را به زانو درآورد\",\"handle\":\"@historic_philosophy\"}'",
    "quotas": "remotion lambda quotas --region=eu-west-1",
    "validate:aws": "remotion lambda policies validate"
  },
  "dependencies": {
    "@remotion/cli": "4.0.543",
    "@remotion/lambda": "4.0.543",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.543"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  }
}